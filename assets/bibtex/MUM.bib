abstract = {Introducing assistive technologies such as robots into care-home environments can substantially change established workflows, yet care professionals have limited opportunities to experience and evaluate them before real-world deployment. Therefore, we developed and tested a virtual reality (VR) application with 22 care professionals, comparing conventional care with a robot-assisted approach in terms of perceived workload and usability. Results indicate that robotic assistance significantly reduces perceived workload and improves usability compared to the traditional workflow, highlighting the potential of robotic assistance for nursing tasks and VR as a motivational training tool. Our findings provide practical implications for care institutions and inform future investigations. We highlight VR’s potential as an early-stage platform for exploring human-robot interaction before real-world implementation.},
booktitle = {Proceedings of the 25th International Conference on Mobile and Ubiquitous Multimedia},
pages = {622–625},
numpages = {4},
keywords = {Human-Robot Interaction, Virtual Reality, Nursing Staff, Long-Term Care, Usability, Workload},
location = {Glasgow, United Kingdom},
series = {MUM '26}
}